{
  "name": "tiny-vlq",
  "version": "0.0.0",
  "description": "Base64 VLQ encoding and decoding for signed 32-bit integers.",
  "keywords": [
    "base64",
    "codec",
    "source-map",
    "sourcemap",
    "vlq"
  ],
  "homepage": "https://github.com/outslept/tiny-vlq#readme",
  "bugs": {
    "url": "https://github.com/outslept/tiny-vlq/issues"
  },
  "license": "MIT",
  "author": "outslept",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outslept/tiny-vlq.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^12.0.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  }
}
