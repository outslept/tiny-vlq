{
  "name": "tiny-vlq",
  "version": "0.0.0",
  "description": "Base64 VLQ encoding and decoding for signed 32-bit integers.",
  "keywords": [
    "base64",
    "codec",
    "source-map",
    "sourcemap",
    "vlq"
  ],
  "homepage": "https://github.com/outslept/tiny-vlq#readme",
  "bugs": {
    "url": "https://github.com/outslept/tiny-vlq/issues"
  },
  "license": "MIT",
  "author": "outslept",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outslept/tiny-vlq.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --dts",
    "dev": "tsdown --dts --watch",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "publint": "tsdown --dts --publint"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "tsdown": "latest",
    "typescript": "^7.0.2",
    "vitest": "latest"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.28.11",
      "onFail": "download"
    }
  }
}
